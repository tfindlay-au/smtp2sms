# Copy to .env, fill in values, chmod 600 .env
ALLOWED_SOURCE_IPS=10.1.10.10,10.1.10.30,10.1.10.35,10.1.10.40,10.1.10.50
RUT_HOST=10.2.10.1
RUT_MODEM=1-1.4
RUT_SMS_USERNAME=smsapi
